# Copy to .env and fill in. Only ANTHROPIC_API_KEY and TRANSCRIBE_API_KEY are needed for the demo.

# --- Staff login for the review screens (leave empty only on your own laptop)
STAFF_USERNAME=ps43
# Login is off: anyone with the link can open the site. To turn it on: REQUIRE_LOGIN=true and a STAFF_PASSWORD.
REQUIRE_LOGIN=
STAFF_PASSWORD=

# --- Claude: photo/video/PDF descriptions and the AI case draft
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (Console > Settings > Workspaces, starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=
SUMMARY_MODEL=claude-haiku-5-5
VISION_MODEL=claude-haiku-5-5
STAFF_LANGUAGE=English
AUTO_SUMMARIZE=true

# --- Speech-to-text (voice notes, calls, video sound)
# Groq's hosted Whisper large-v3 (free tier, fast). For OpenAI instead:
#   TRANSCRIBE_BASE_URL=https://api.openai.com/v1  TRANSCRIBE_MODEL=whisper-1
# For free on-device transcription: TRANSCRIBE_PROVIDER=local and `pip install faster-whisper`
TRANSCRIBE_PROVIDER=openai
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_MODEL=whisper-large-v3
TRANSCRIBE_API_KEY=

# --- Public URL of this server (Railway sets it by itself)
PUBLIC_BASE_URL=http://localhost:8000

# --- WhatsApp number shown on the public sign-up page (/join), e.g. +237 6...
PUBLIC_WHATSAPP=+16479017011

# --- Mac call recorder (recorder/ folder): any long random string, same value in ~/.bridge43/recorder.json
RECORDER_TOKEN=

# --- KoBoToolbox field forms (optional)
KOBO_WEBHOOK_SECRET=
KOBO_API_TOKEN=
KOBO_CONTACT_FIELDS=phone,school_phone,school_name

DATA_DIR=data
# Everything from one contact stays in one case until staff close it; >0 = also start a new case after that many quiet hours
THREAD_IDLE_HOURS=0
